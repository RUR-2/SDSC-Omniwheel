import cv2
import numpy as np
import pyrealsense2 as rs
from ultralytics import YOLO

# 1. Load the YOLOv11 nano model
model = YOLO("yolo11n.pt")

# 2. Configure Intel RealSense pipeline for both Color and Depth
pipeline = rs.pipeline()
config = rs.config()

# Enable streams (Resolution: 640x480, 30 FPS)
config.enable_stream(rs.stream.depth, 640, 480, rs.format.z16, 30)
config.enable_stream(rs.stream.color, 640, 480, rs.format.bgr8, 30)

# Start streaming
print("Starting RealSense camera with Depth...")
profile = pipeline.start(config)

# Align depth frame to color frame so coordinates match pixel-for-pixel
align_to = rs.stream.color
align = rs.align(align_to)

try:
    while True:
        # Wait for a coherent pair of frames
        frames = pipeline.wait_for_frames()
        
        # Align frames
        aligned_frames = align.process(frames)
        depth_frame = aligned_frames.get_depth_frame()
        color_frame = aligned_frames.get_color_frame()
        
        if not depth_frame or not color_frame:
            continue

        # Convert images to numpy arrays
        frame = np.asanyarray(color_frame.get_data())
        
        # 3. Run YOLOv11 inference, filtering only for humans (class 0)
        results = model(frame, classes=[0], verbose=False)

        # 4. Extract bounding boxes and calculate distance
        # results[0].boxes contains all detection data
        boxes = results[0].boxes.xyxy.cpu().numpy()  # [x1, y1, x2, y2]
        
        # Plot the standard YOLO bounding boxes first
        annotated_frame = results[0].plot()

        for box in boxes:
            x1, y1, x2, y2 = map(int, box[:4])
            
            # Find the center point (or any point inside the box) of the human
            cx = int((x1 + x2) / 2)
            cy = int((y1 + y2) / 2)
            
            # Get distance at the center point (returns meters)
            distance = depth_frame.get_distance(cx, cy)
            
            # If distance is valid (> 0), display it on the frame
            if distance > 0:
                distance_text = f"{distance:.2f} m"
                # Draw text background / text above the bounding box
                cv2.putText(
                    annotated_frame, 
                    f"Dist: {distance_text}", 
                    (x1, max(y1 - 10, 20)), 
                    cv2.FONT_HERSHEY_SIMPLEX, 
                    0.6, 
                    (0, 255, 0), 
                    2
                )

        # Display the live stream
        cv2.imshow("Intel RealSense - YOLOv11 + Distance", annotated_frame)

        # Break loop on pressing 'q'
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

finally:
    # Stop streaming
    pipeline.stop()
    cv2.destroyAllWindows()